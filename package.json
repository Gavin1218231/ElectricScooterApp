{
  "name": "vim-scooter-app",
  "version": "1.0.0",
  "description": "Vim Electric Scooter Rental App - Rent, Ride, Return",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx react-scripts start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npx react-scripts build",
    "seed": "node server/seed.js",
    "start": "npm run server"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.3"
  }
}
